{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobsite-rust.vercel.app/schemas/backup-v2.json",
  "title": "Job Posting Hub Backup v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "exportedAt", "legacy", "personalStates", "duplicateDecisions", "manualLinks"],
  "$defs": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "externalId", "originalUrl"],
      "properties": {
        "provider": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,39}$" },
        "externalId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "originalUrl": { "type": "string", "format": "uri", "maxLength": 2048, "pattern": "^https://" }
      }
    },
    "safeDisplay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "maxLength": 300 },
        "companyName": { "type": "string", "maxLength": 200 },
        "roleName": { "type": "string", "maxLength": 200 },
        "locations": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 100 } },
        "postedAt": { "type": "string", "format": "date-time" },
        "deadlineAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "properties": {
    "version": { "const": 2 },
    "exportedAt": { "type": "string", "format": "date-time" },
    "legacy": { "type": "object", "description": "Closed v1-compatible payload; v1 statuses remain legacy data." },
    "personalStates": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceRef", "updatedAt"],
        "properties": {
          "sourceRef": { "$ref": "#/$defs/sourceRef" },
          "displaySnapshot": { "$ref": "#/$defs/safeDisplay" },
          "saved": { "type": "boolean" },
          "excluded": { "type": "boolean" },
          "applicationStatus": { "enum": ["unreviewed", "planned", "applied", "interviewing", "offered", "rejected", "withdrawn"] },
          "memo": { "type": "string", "maxLength": 10000 },
          "nextActionAt": { "type": ["string", "null"], "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "duplicateDecisions": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["leftSourceRef", "rightSourceRef", "decision"],
        "properties": {
          "leftSourceRef": { "$ref": "#/$defs/sourceRef" },
          "rightSourceRef": { "$ref": "#/$defs/sourceRef" },
          "decision": { "enum": ["merged", "separate"] },
          "leftDisplaySnapshot": { "$ref": "#/$defs/safeDisplay" },
          "rightDisplaySnapshot": { "$ref": "#/$defs/safeDisplay" },
          "representativeSourceRef": { "oneOf": [{ "$ref": "#/$defs/sourceRef" }, { "type": "null" }] }
        }
      }
    },
    "manualLinks": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["legacyJobId", "sourceRef"],
        "properties": {
          "legacyJobId": { "type": "string", "format": "uuid" },
          "sourceRef": { "$ref": "#/$defs/sourceRef" }
        }
      }
    }
  }
}
